---
import LangSwitch from './LangSwitch.astro';
import Logo from '../assets/icon/HOYEONGRANDE_Logo2.svg';
import { localePath, t, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  name: string;
}

const { lang, name } = Astro.props;
const sections = [
  { href: '#about', label: t(lang, 'nav.about') },
  { href: '#media', label: t(lang, 'nav.media') },
  { href: '#history', label: t(lang, 'nav.history') },
  { href: '#contact', label: t(lang, 'nav.contact') },
];
---

<!-- [햄버거 메뉴] [가운데 로고] [언어 선택] -->
<header class="nav" data-nav>
  <div class="container inner">
    <details class="menu" data-dropdown>
      <summary aria-label={t(lang, 'nav.menu')}>
        <span class="bars" aria-hidden="true"><span></span><span></span><span></span></span>
      </summary>
      <nav class="panel" aria-label={t(lang, 'nav.menu')}>
        <ul>
          {
            sections.map((s) => (
              <li>
                <a href={s.href} data-section-link>
                  {s.label}
                </a>
              </li>
            ))
          }
          <li class="divider">
            <a href={localePath(lang, 'links')}>{t(lang, 'nav.links')} →</a>
          </li>
        </ul>
      </nav>
    </details>

    <a class="logo" href="#main" aria-label={name}>
      <Logo fill="currentColor" height={30} width={83} aria-hidden="true" />
    </a>

    <div class="end">
      <LangSwitch lang={lang} path="" />
    </div>
  </div>
</header>

<script>
  // 아래로 스크롤하면 헤더를 숨기고, 위로 조금이라도 스크롤하면 다시 보여준다.
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  if (nav) {
    const THRESHOLD = 8; // 이만큼(px) 이상 움직였을 때만 반응 (손떨림 무시)
    let lastY = window.scrollY;
    let ticking = false;
    // 메뉴·로고·화살표로 페이지 안을 이동하는 동안에는 숨기지 않는다
    let jumping = false;

    const update = () => {
      const y = window.scrollY;
      ticking = false;

      if (jumping) {
        nav.classList.remove('is-hidden');
        lastY = y;
        return;
      }

      const delta = y - lastY;
      const menuOpen = nav.querySelector('details[open]') !== null;

      if (y <= nav.offsetHeight || menuOpen) {
        nav.classList.remove('is-hidden'); // 맨 위이거나 메뉴가 열려 있으면 항상 보임
      } else if (delta > THRESHOLD) {
        nav.classList.add('is-hidden');
      } else if (delta < -THRESHOLD) {
        nav.classList.remove('is-hidden');
      }

      if (Math.abs(delta) > THRESHOLD) lastY = y;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      },
      { passive: true },
    );

    // 같은 페이지 #앵커 링크를 누르면, 그 스크롤이 끝날 때까지 헤더를 고정
    document.addEventListener('click', (event) => {
      const link = (event.target as Element | null)?.closest('a[href^="#"]');
      if (!link) return;

      jumping = true;
      nav.classList.remove('is-hidden');

      let timer = 0;
      const release = () => {
        window.removeEventListener('scrollend', release);
        clearTimeout(timer);
        jumping = false;
        lastY = window.scrollY;
      };
      window.addEventListener('scrollend', release);
      timer = window.setTimeout(release, 1500); // scrollend 미지원·스크롤 없음 대비
    });

    // 키보드로 헤더 안에 포커스가 오면 숨어 있어도 보여준다
    nav.addEventListener('focusin', () => nav.classList.remove('is-hidden'));
  }
</script>

<script>
  // 햄버거 메뉴에서 지금 보고 있는 섹션을 강조한다 (aria-current="location").
  // 헤더 바로 아래 기준선(헤더 높이 + 100px)을 지나간 마지막 섹션이 "현재 위치".
  // 화면 비율 기준으로 잡으면 세로로 긴 화면에서 짧은 섹션(About)을 보는 중에도
  // 다음 섹션이 표시되는 문제가 있어서, 화면 크기와 상관없는 고정 위치로 잡는다.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('a[data-section-link]')];
  const sections = links
    .map((link) => document.querySelector<HTMLElement>(link.getAttribute('href') ?? ''))
    .filter((el): el is HTMLElement => el !== null);

  if (links.length && sections.length) {
    let ticking = false;

    const markCurrent = () => {
      ticking = false;
      const header = document.querySelector<HTMLElement>('[data-nav]');
      const line = (header?.offsetHeight ?? 56) + 100;
      let currentId = '';
      for (const section of sections) {
        if (section.getBoundingClientRect().top <= line) currentId = section.id;
      }
      // 맨 아래까지 내렸으면 마지막 섹션(Contact)
      if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) {
        currentId = sections[sections.length - 1].id;
      }
      for (const link of links) {
        if (link.getAttribute('href') === `#${currentId}`) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      }
    };

    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(markCurrent);
      },
      { passive: true },
    );
    window.addEventListener('resize', markCurrent);
    markCurrent();
  }
</script>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    max-width: var(--page-width);
    margin-inline: auto;
    z-index: 50;
    background: color-mix(in srgb, var(--color-bg) 80%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
    transition: transform 0.3s ease;
  }

  .nav.is-hidden {
    transform: translateY(-100%);
  }

  .inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: var(--nav-height);
  }

  .logo {
    display: grid;
    place-items: center;
    min-height: 2.75rem;
    color: var(--color-text);
  }

  .end {
    justify-self: end;
  }

  /* 햄버거 버튼 */
  summary {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-left: calc(var(--space-3) * -1);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .bars {
    position: relative;
    display: block;
    width: 1.25rem;
    height: 0.875rem;
  }

  .bars span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    border-radius: 1px;
    background: var(--color-text);
    transition:
      transform 0.25s ease,
      opacity 0.2s ease;
  }

  .bars span:nth-child(1) {
    top: 0;
  }

  .bars span:nth-child(2) {
    top: calc(50% - 1px);
  }

  .bars span:nth-child(3) {
    bottom: 0;
  }

  /* 열리면 X 로 */
  .menu[open] .bars span:nth-child(1) {
    transform: translateY(0.375rem) rotate(45deg);
  }

  .menu[open] .bars span:nth-child(2) {
    opacity: 0;
  }

  .menu[open] .bars span:nth-child(3) {
    transform: translateY(-0.375rem) rotate(-45deg);
  }

  /* 펼쳐지는 메뉴: 헤더 바로 아래 전체 폭 */
  .panel {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    padding: var(--space-2) var(--gutter) var(--space-6);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .panel ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .panel a {
    display: flex;
    align-items: center;
    min-height: 3.25rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-xl);
    font-weight: 800;
    text-decoration: none;
    text-transform: uppercase;
  }

  /* 지금 보고 있는 섹션 */
  .panel a[aria-current='location'] {
    color: var(--color-accent);
  }

  .panel a:hover {
    color: var(--color-accent);
  }

  .divider {
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .divider a {
    min-height: 2.75rem;
    color: var(--color-muted);
    font-family: var(--font-body);
    font-style: normal;
    font-size: var(--text-base);
    font-weight: 600;
    text-transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav,
    .bars span {
      transition: none;
    }
  }
</style>
