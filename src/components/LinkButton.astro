---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { localize, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  link: CollectionEntry<'links'>['data'];
}

const { lang, link } = Astro.props;
const external = !link.url.startsWith('mailto:');
---

<a
  class:list={['button', { highlight: link.highlight }]}
  href={link.url}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
  data-link-id={link.id}
>
  <Icon name={link.icon} size={20} />
  <span class="label">{localize(link.label, lang)}</span>
</a>

<style>
  .button {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 3.5rem;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    font-weight: 600;
    text-decoration: none;
    transition:
      border-color 0.2s,
      transform 0.2s;
  }

  .label {
    flex: 1;
    text-align: center;
    /* 왼쪽 아이콘만큼 오른쪽을 비워 글자를 가운데에 둔다 */
    margin-right: calc(20px + var(--space-3));
  }

  .button:hover {
    border-color: var(--color-text);
  }

  .button:active {
    transform: scale(0.98);
  }

  .highlight {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-accent-text);
  }

  .highlight:hover {
    border-color: var(--color-accent);
  }
</style>
