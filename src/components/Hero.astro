---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { localize, t, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  profile: CollectionEntry<'profile'>['data'];
}

const { lang, profile } = Astro.props;
const tagline = localize(profile.tagline, lang);
---

<section class="hero" aria-labelledby="hero-title">
  {
    profile.photo && (
      <Image
        class="photo"
        src={profile.photo}
        alt={localize(profile.photoAlt, lang) ?? profile.name}
        widths={[640, 960, 1280]}
        // 세로 사진(2:3)으로 화면을 채운다. 휴대폰에서는 화면 높이의 약 0.67배 폭으로 표시
        sizes="(min-width: 640px) 640px, 67vh"
        loading="eager"
        fetchpriority="high"
      />
    )
  }
  <div class="container content">
    <h1 id="hero-title" class="name">{profile.name}</h1>
    <p class="tagline">{tagline}</p>
    {profile.genres.length > 0 && <p class="genres">{profile.genres.join(' · ')}</p>}
  </div>
  <a class="scroll" href="#about">
    <span class="visually-hidden">{t(lang, 'hero.scroll')}</span>
    <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 4v16m0 0-6-6m6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.5"></path>
    </svg>
  </a>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 100svh;
    padding-block: calc(var(--nav-height) + var(--space-8)) var(--space-24);
    isolation: isolate;
    overflow: hidden;
  }

  .photo {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }

  /* 사진 위 글자가 읽히도록 아래쪽을 어둡게 */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-bg) 30%, transparent) 0%,
      color-mix(in srgb, var(--color-bg) 10%, transparent) 40%,
      var(--color-bg) 100%
    );
  }

  .name {
    /* 12자 이름이 360px 화면에서도 한 줄에 들어가는 크기 */
    font-size: min(9vw, 3.75rem);
    overflow-wrap: normal;
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }

  .tagline {
    margin: var(--space-4) 0 0;
    font-size: var(--text-lg);
  }

  .genres {
    margin: var(--space-2) 0 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .scroll {
    position: absolute;
    left: 50%;
    bottom: var(--space-6);
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    translate: -50% 0;
    color: var(--color-muted);
  }

  @media (prefers-reduced-motion: no-preference) {
    .scroll svg {
      animation: nudge 2s ease-in-out infinite;
    }
  }

  @keyframes nudge {
    50% {
      transform: translateY(6px);
    }
  }
</style>
