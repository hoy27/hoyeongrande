---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { localize, t, type Lang } from '../i18n/utils';

type LocalizedText = CollectionEntry<'profile'>['data']['bookingTypes'][number];

interface Props {
  lang: Lang;
  email: string;
  links: CollectionEntry<'links'>['data'][];
  /** 섭외 가능한 행사 종류 */
  bookingTypes?: LocalizedText[];
  /** 프레스킷 링크. 비어 있으면 버튼을 숨긴다 */
  presskit?: string;
}

const { lang, email, links, bookingTypes = [], presskit = '' } = Astro.props;
// 이메일은 위에 따로 보여주므로 아이콘 줄에서는 뺀다
const social = links.filter((link) => !link.url.startsWith('mailto:'));
---

<section id="contact" class="section container reveal" aria-labelledby="contact-title">
  <h2 id="contact-title" class="section-title">{t(lang, 'contact.title')}</h2>
  <p class="label">{t(lang, 'contact.booking')}</p>
  {
    bookingTypes.length > 0 && (
      <ul class="types">
        {bookingTypes.map((type) => (
          <li>{localize(type, lang)}</li>
        ))}
      </ul>
    )
  }
  <a class="email" href={`mailto:${email}`} data-contact="email">{email}</a>
  {
    presskit && (
      <a class="presskit" href={presskit} target="_blank" rel="noopener" data-link-id="presskit">
        <Icon name="file" size={18} />
        {t(lang, 'contact.presskit')}
      </a>
    )
  }

  <ul class="social">
    {
      social.map((link) => {
        const label = localize(link.label, lang);
        return (
          <li>
            <a
              href={link.url}
              target="_blank"
              rel="noopener"
              aria-label={t(lang, 'social.label', { name: label })}
              data-link-id={link.id}
            >
              <Icon name={link.icon} size={22} />
            </a>
          </li>
        );
      })
    }
  </ul>
</section>

<style>
  .section {
    padding-bottom: var(--space-24);
  }

  .label {
    margin: 0 0 var(--space-2);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .email {
    font-family: var(--font-display);
    font-style: italic;
    /* 긴 주소도 360px 화면에서 한 줄에 들어가는 크기 */
    font-size: min(5.6vw, 1.5rem);
    font-weight: 700;
    white-space: nowrap;
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }

  /* 섭외 가능한 행사 종류 */
  .types {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-2) 0 var(--space-4);
    padding: 0;
    list-style: none;
  }

  .types li {
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: var(--text-sm);
  }

  .presskit {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    margin-top: var(--space-6);
    padding-inline: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .presskit:hover {
    border-color: var(--color-accent);
  }

  .social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-8) 0 0;
    padding: 0;
    list-style: none;
  }

  .social a {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    color: var(--color-text);
    transition: border-color 0.2s;
  }

  .social a:hover {
    border-color: var(--color-accent);
  }
</style>
