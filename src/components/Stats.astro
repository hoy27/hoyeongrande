---
import type { CollectionEntry } from 'astro:content';
import { splitCareer, type CareerItem } from '../lib/career';
import { localize, t, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  profile: CollectionEntry<'profile'>['data'];
  career: CareerItem[];
}

const { lang, profile, career } = Astro.props;

// 지난 공연 수를 10 단위로 내려서 "60+" 처럼 보여준다 (career.yaml 에 추가하면 자동 반영)
const { past } = splitCareer(career);
const shows = past.length >= 10 ? `${Math.floor(past.length / 10) * 10}+` : String(past.length);
const highlights = profile.highlights.map((h) => localize(h, lang));
---

<!-- About 위 요약 박스: 섭외 담당자가 한눈에 보는 숫자와 주요 무대 -->
<aside class="container reveal" aria-label={t(lang, 'stats.highlights')}>
  <div class="callout">
    <dl class="stats">
      {
        profile.since && (
          <div>
            <dt>{t(lang, 'stats.since')}</dt>
            <dd>{profile.since}</dd>
          </div>
        )
      }
      <div>
        <dt>{t(lang, 'stats.shows')}</dt>
        <dd>{shows}</dd>
      </div>
    </dl>
    {
      highlights.length > 0 && (
        <div class="highlights">
          <p class="label">{t(lang, 'stats.highlights')}</p>
          <ul>
            {highlights.map((h) => (
              <li>{h}</li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</aside>

<style>
  aside {
    padding-top: var(--space-12);
  }

  .callout {
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .stats {
    display: flex;
    gap: var(--space-8);
    margin: 0;
  }

  /* 숫자가 위, 설명이 아래 */
  .stats div {
    display: flex;
    flex-direction: column-reverse;
  }

  dt,
  .label {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: min(10vw, 2.75rem);
    font-style: italic;
    font-weight: 800;
    line-height: 1.1;
  }

  .highlights {
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .highlights ul {
    display: grid;
    gap: var(--space-1);
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
    font-weight: 600;
  }
</style>
