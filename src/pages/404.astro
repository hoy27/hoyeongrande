---
import Base from '../layouts/Base.astro';
import { localePath, t } from '../i18n/utils';
---

<Base lang="ko" page="404" title="404" description={t('ko', 'notFound.title')} noindex>
  <main class="page">
    <p class="code">404</p>
    <h1 class="title">{t('ko', 'notFound.title')}</h1>
    <p class="sub" lang="en">{t('en', 'notFound.title')}</p>
    <div class="actions">
      <a class="button primary" href={localePath('ko')}>{t('ko', 'notFound.home')}</a>
      <a class="button" href={localePath('ko', 'links')}>{t('ko', 'notFound.links')}</a>
    </div>
  </main>
</Base>

<style>
  .page {
    display: grid;
    place-content: center;
    justify-items: center;
    min-height: 100svh;
    padding: var(--space-8) var(--space-4);
    text-align: center;
  }

  .code {
    margin: 0;
    font-size: var(--text-display);
    font-weight: 900;
    line-height: 1;
  }

  .title {
    margin-top: var(--space-4);
    font-size: var(--text-lg);
  }

  .sub {
    margin: var(--space-1) 0 0;
    color: var(--color-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .button {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding-inline: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    font-weight: 600;
    text-decoration: none;
  }

  .primary {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-accent-text);
  }
</style>
